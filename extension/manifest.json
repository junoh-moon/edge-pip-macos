{
  "manifest_version": 3,
  "name": "Edge PiP Controls",
  "description": "PIP로 재생 중인 영상의 재생·탐색·음량을 이 Mac의 Edge PiP 창에서 조절합니다.",
  "version": "1.4.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": [
        "media-actions.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": [
        "protection.js",
        "player.js"
      ]
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ]
}
